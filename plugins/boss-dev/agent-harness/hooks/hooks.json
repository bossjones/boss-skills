        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop.py --chat"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/tmux_notify.py --event stop"
