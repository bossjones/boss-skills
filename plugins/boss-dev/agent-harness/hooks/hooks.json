{
  "description": "Lifecycle hooks for the agent-harness plugin: logging, dangerous-command guards, permission auto-allow, TTS announcements, and Python auto-format on edit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/log_event.py --event-type PreToolUse"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre_tool_use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/log_event.py --event-type PostToolUse"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/post_tool_use.py"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/ruff_autoformat.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/log_event.py --event-type Notification"
