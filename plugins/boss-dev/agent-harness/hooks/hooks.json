      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/notification.py --notify"
          }
        ]
      },
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/uv-guard.sh run \"${CLAUDE_PLUGIN_ROOT}\"/hooks/tmux_notify.py --event notification"
