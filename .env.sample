ANTHROPIC_API_KEY=
# Dedicated key for skill-evals / plugin-eval `--auth api-key`. Kept under its own
# name so it never reaches Claude Code's own auth: scripts/eval-skills.py maps it to
# ANTHROPIC_API_KEY for the plugin-eval subprocess only. If you only want the eval
# tooling to use a key, set this and leave ANTHROPIC_API_KEY above empty.
BOSS_SKILL_ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ENGINEER_NAME=bossjones
OPENAI_API_KEY=

# Second brain vault (obsidian-wiki). Documented default only — the real path is
# persisted globally in ~/.obsidian-wiki/config by `obsidian-wiki setup`.
# Note: `~` is NOT auto-expanded by env consumers; call expanduser if read in code.
OBSIDIAN_VAULT_PATH=~/Documents/obsidian/personal.vault

# Optional QMD semantic search (npm install -g @tobilu/qmd; needs Node >= 22).
# The wiki skills read these from ~/.obsidian-wiki/config and fall back to Grep when unset.
# QMD_TRANSPORT=cli            # cli or mcp
# QMD_WIKI_COLLECTION=wiki     # collection queried by wiki-query
# QMD_PAPERS_COLLECTION=papers # collection queried by wiki-ingest
# QMD_CLI_SEARCH_MODE=quality  # quality | balanced | fast (cli transport)